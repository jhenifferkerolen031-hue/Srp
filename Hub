local conns = {}
local function connect(sig, fn) local c = sig:Connect(fn); conns[#conns + 1] = c; return c end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function round(o, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, o) end
local function circle(o) return new("UICorner", {CornerRadius = UDim.new(1, 0)}, o) end

-- roda uma função sem derrubar o resto do script se ela der erro (avisa uma vez no console)
local warned = {}
local function safe(name, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok and not warned[name] then
		warned[name] = true
		warn("[pvp universal] " .. name .. ": " .. tostring(err))
	end
end

-- linha entre dois pontos 2D usando um Frame girado (funciona em qualquer executor, inclusive mobile)
local function setLine(f, a, b, th, color)
	local dx, dy = b.X - a.X, b.Y - a.Y
	f.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), th)
	f.Position = UDim2.fromOffset((a.X + b.X) * 0.5, (a.Y + b.Y) * 0.5)
	f.Rotation = math.deg(math.atan2(dy, dx))
	f.BackgroundColor3 = color
	f.Visible = true
end
local function place(f, x, y, w, h, color)
	f.Position, f.Size, f.BackgroundColor3, f.Visible = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h), color, true
end

-- amigos (consulta em segundo plano, com cache)
local friendCache = {}
local function isFriend(plr)
	local c = friendCache[plr.UserId]
	if c == nil then
		friendCache[plr.UserId] = false
		task.spawn(function()
			local ok, r = pcall(function() return LocalPlayer:IsFriendsWith(plr.UserId) end)
			friendCache[plr.UserId] = ok and r == true
		end)
		return false
	end
	return c
end

